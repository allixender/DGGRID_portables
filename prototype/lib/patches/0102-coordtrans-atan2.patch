From 081c0fac9bfda6ff11b36d15785ce3487b749376 Mon Sep 17 00:00:00 2001
From: Alexander Kmoch <alex@geolynx.ee>
Date: Fri, 2 Oct 2026 21:13:35 +0300
Subject: [PATCH] coordtrans: longitude via atan2 instead of acos

acos(x / sin(lat)) is ill-conditioned near +-1. The rotated south pole vertex
(vertsnew[11]) hits exactly that case: mathematically x / sin(lat) = -1, but a
few ulp of libm rounding with a 53-bit long double move the vertex by up to
3.6e-8 rad, and with it the centres and dazh of triangles 15-19, so points near
a cell edge there land in the neighbouring cell (seen on wasm32 with musl libm,
likely also windows-arm64 UCRT). atan2(y, x) with the same sign convention is
well conditioned everywhere.
---
 src/lib/dglib/lib/DgProjTriRF.cpp | 17 ++++++++---------
 1 file changed, 8 insertions(+), 9 deletions(-)

diff --git a/src/lib/dglib/lib/DgProjTriRF.cpp b/src/lib/dglib/lib/DgProjTriRF.cpp
index 9de6614..48d6199 100644
--- a/src/lib/dglib/lib/DgProjTriRF.cpp
+++ b/src/lib/dglib/lib/DgProjTriRF.cpp
@@ -85,7 +85,7 @@ GeoCoord coordtrans(const GeoCoord& newNPold, const GeoCoord& ptold,
    coordinates. */
 
  {
-  long double cosptnewlat, cosptnewlon;
+  long double cosptnewlat;
   GeoCoord ptnew;
 
   cosptnewlat = sinl(newNPold.lat)*sinl(ptold.lat) +
@@ -99,14 +99,13 @@ GeoCoord coordtrans(const GeoCoord& newNPold, const GeoCoord& ptold,
       ptnew.lon=0.;
   else
    {
-    cosptnewlon = (sinl(ptold.lat)*cosl(newNPold.lat) - cosl(ptold.lat)*
-                  sinl(newNPold.lat)*cosl(newNPold.lon-ptold.lon))/sinl(ptnew.lat);
-    if (cosptnewlon>1.0L) cosptnewlon=1.0L;
-    if (cosptnewlon<-1.0L) cosptnewlon=-1.0L;
-    ptnew.lon = acosl(cosptnewlon);
-    if ((ptold.lon-newNPold.lon)>=0 && (ptold.lon-newNPold.lon) < M_PI)
-      ptnew.lon=-ptnew.lon+lon0;
-    else ptnew.lon=ptnew.lon+lon0;
+    // atan2 instead of acos(x / sin(ptnew.lat)) + a sign test: acos is
+    // ill-conditioned near +-1, so with a 53-bit long double e.g. the rotated
+    // south pole vertex moved by up to 4e-8 rad depending on libm rounding
+    long double x = sinl(ptold.lat)*cosl(newNPold.lat) - cosl(ptold.lat)*
+                    sinl(newNPold.lat)*cosl(newNPold.lon-ptold.lon);
+    long double y = cosl(ptold.lat)*sinl(ptold.lon-newNPold.lon);
+    ptnew.lon = lon0 - atan2l(y, x);
     if (ptnew.lon>M_PI) ptnew.lon -= 2*M_PI;
     if (ptnew.lon<-M_PI) ptnew.lon += 2*M_PI;
    }
-- 
